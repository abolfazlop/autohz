<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
 <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"/>
 <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
 <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
 <permission android:name="com.abolfazl.hzswitcher.permission.WRITE_CLIP" android:protectionLevel="signature"/>
 <application android:theme="@android:style/Theme.Material.Light.NoActionBar" android:label="PulseXt" android:icon="@drawable/ic_pulsext" android:supportsRtl="true">
  <meta-data android:name="xposedmodule" android:value="true"/>
  <meta-data android:name="xposedminversion" android:value="93"/>
  <meta-data android:name="xposeddescription" android:value="@string/xposed_description"/>
  <meta-data android:name="xposedscope" android:resource="@array/xposed_scope"/>
  <service android:name=".GameProfileMonitorService" android:exported="false" android:stopWithTask="false" android:foregroundServiceType="specialUse">
   <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="User-started game profile session monitor that restores the user's previous display brightness and media volume after the selected game exits."/>
  </service>
  <activity android:name=".ClipboardActivity" android:exported="false"/>
  <provider android:name=".ClipboardCaptureProvider" android:authorities="com.abolfazl.hzswitcher.clipboard.provider" android:exported="true" android:permission="com.abolfazl.hzswitcher.permission.WRITE_CLIP"/>
  <activity android:name=".MainActivity" android:exported="true">
   <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
  </activity>
 </application>
</manifest>
