#!/system/bin/sh
MODDIR=${0%/*}
CTL="$MODDIR/bin/rodin_ctl"
cmd=${1:-status}
rate=${2:-}
DEVICE="$(getprop ro.product.device)"
BASE=/data/adb/pulsext-touch
STATE="$BASE/rodin-state"

if [ "$DEVICE" != "rodin" ]; then
  echo "error=unsupported_device"
  echo "device=$DEVICE"
  echo "supported_device=rodin"
  exit 3
fi
if [ ! -x "$CTL" ]; then echo "error=rodin_ctl_missing"; exit 4; fi

snapshot() {
  "$CTL" "GET snapshot" 2>&1
}

case "$cmd" in
  probe|status)
    echo "engine=PulseXtTouchEngine"
    echo "backend=Rodin-Essential-v1.18.5"
    echo "device=$DEVICE"
    if pidof rodin_daemon >/dev/null 2>&1; then echo "daemon=running"; else echo "daemon=stopped"; fi
    snapshot
    ;;
  apply)
    case "$rate" in
      240) profile=1 ;;
      480) profile=2 ;;
      1000) profile=3 ;;
      0) profile=0 ;;
      *) echo "error=invalid_rate"; exit 2 ;;
    esac
    response="$("$CTL" "SET touch $profile" 2>&1)"
    echo "$response"
    echo "$response" | grep -q '^OK applied$' || exit 5
    live="$(snapshot)"
    echo "$live"
    echo "$live" | grep -q "^touch=$profile$" || { echo "error=touch_profile_readback_mismatch"; exit 6; }
    if [ "$profile" = 3 ]; then
      echo "$live" | grep -q '^touch_resampler_ready=1000$' || { echo "error=1000hz_resampler_not_ready"; exit 7; }
      echo "$live" | grep -q '^touch_ack=1$' || { echo "error=touch_apply_not_acknowledged"; exit 8; }
    elif [ "$profile" = 0 ]; then
      echo "$live" | grep -q '^touch_ack=-1$' || { echo "error=touch_restore_not_acknowledged"; exit 8; }
    else
      echo "$live" | grep -q '^touch_ack=1$' || { echo "error=touch_apply_not_acknowledged"; exit 8; }
    fi
    ;;
  restore)
    response="$("$CTL" "SET touch 0" 2>&1)"
    echo "$response"
    echo "$response" | grep -q '^OK applied$' || exit 5
    live="$(snapshot)"
    echo "$live"
    echo "$live" | grep -q '^touch=-1$' || { echo "error=touch_restore_state_mismatch"; exit 6; }
    echo "$live" | grep -q '^touch_ack=-1$' || { echo "error=touch_restore_not_acknowledged"; exit 8; }
    ;;
  *)
    echo "usage: pulsext-touchctl {probe|status|apply 240|480|1000|restore}"
    exit 2
    ;;
esac
